* Simplified working copy of cycloinv_target2_graphite.inp; original preserved.
* Recommended executable: /usr/local/fluka/bin/flukadpm; no run performed.
* Working copy: configure here with the native FLUKA preprocessor.
* Original cyclotron_activation.inp is preserved. No generator required.
* Negative BEAM energy is GeV; baseline 23.5 MeV at source.
#define EBEAM 0.0235
* Graphite partial density (g carbon/cm3 mixture); fixed Ra/Cl loading.
#define CRHO 1.55243508
#define RARHO 0.32023413
#define CLRHO 0.10043079
#define RHOM 1.9731
* Keep RHOM = CRHO + RARHO + CLRHO; case generator updates both.
* Proton scoring range: raise EMAX above highest requested source energy.
#define EMAX 0.06
#define NEBIN 1200
* Seven days in seconds; 400 microA singly charged protons in particles/s.
#define IRRT 604800
#define RATE 2496603600000000
#define NHIST 1000000
#define SEED 54227137
* Energy cutoffs in GeV; electron value below is kinetic energy.
#define ECUT 0.0001
#define GCUT 1E-06
#define NTEMP 296
* Neutron library is set literally on LOW-PWXS: JEFF-3.3.
* Keep this hyphenated name out of #define expression evaluation.
* Defined switches are ON. Remove or #undef to turn OFF; value 0 is ON.
#define PHNUC 
#define PENETR 
* Cartesian fluence maps: cm, bin counts; shared grid for all particles.
#define XYZMAP 
#define XYMAX 1.3
#define ZMIN -0.02
#define ZMAX 1.8
#define NXY 51
#define NZ 260
TITLE
RaCl2 graphite target: enclosed Al housing, variable energy/loading
DEFAULTS                                                              PRECISIO
* Current user beam retained: Gaussian x/y FWHM 0.68 cm; no divergence.
BEAM         -$EBEAM       0.0       0.0      -1.6      -1.6       1.0PROTON
BEAMPOS          0.0       0.0      -5.0
* Supplied MCNP x axis mapped to FLUKA +z; target front z=0.155 cm.
GEOBEGIN                                                              COMBNAME
    0    0          Enclosed target: one Al housing, one exterior vacuum
SPH world      0 0 0.255 110
* Housing outer envelope; inner cavity starts behind 0.5 mm Al front.
RCC outer      0 0 0 0 0 1.755 1.2
RCC inner      0 0 0.05 0 0 1.505 1
* Only four internal interfaces; cavity RCC defines its two ends.
XYP watend     0.15
XYP taend      0.155
XYP tgtend     0.355
XYP cuend      0.555
END
BLKHOLE      5 -world
VACREG       5 +world -outer
ALCASE       5 +outer -inner
WAT          5 +inner +watend
TAWIN        5 +inner -watend +taend
CUBACK       5 +inner -tgtend +cuend
COOL         5 +inner -cuend
TGT          5 +inner -taend +tgtend
END
GEOEND
* Elemental materials for Al6061 alloy.
MATERIAL          24                7.19                              CHROMIUM
MATERIAL          25                7.21                              MANGANES
* Al 6061: supplied MCNP M1 mass proportions, density 2.7 g/cm3.
MATERIAL          30               7.133                              ZINC
MATERIAL                             2.7                              AL6061
COMPOUND       -0.01  MAGNESIU    -0.972  ALUMINUM    -0.006   SILICONAL6061
COMPOUND   -0.000876  TITANIUM  -0.00195  CHROMIUM -0.000876  MANGANESAL6061
COMPOUND   -0.004088      IRON  -0.00275    COPPER  -0.00146      ZINCAL6061
* Supplied mass composition: Ra226 0.1623, carbon 0.7868, Cl 0.0509.
* Preserve supplied rounded Ra/Cl ratio, rather than silently adjusting it.
MATERIAL          88                 5.5                           226RADIUM
MATERIAL          17           0.0029947                              CHLORINE
MATERIAL          73              16.654                           181TANTALUM
MATERIAL          29                8.96                            63CU63
MATERIAL          29                8.96                            65CU65
MATERIAL                            8.96                              CUMIX
COMPOUND      0.6917      CU63    0.3083      CU65                    CUMIX
MATERIAL                           $RHOM                              RACL2
COMPOUND     -$RARHO    RADIUM    -$CRHO    CARBON   -$CLRHO  CHLORINERACL2
ASSIGNMA    BLCKHOLE   BLKHOLE
ASSIGNMA      VACUUM    VACREG
ASSIGNMA      AL6061    ALCASE
ASSIGNMA       WATER       WAT
ASSIGNMA    TANTALUM     TAWIN
ASSIGNMA       CUMIX    CUBACK
ASSIGNMA       WATER      COOL
ASSIGNMA       RACL2       TGT
* Inventory physics retained; explicit pointwise library selection.
PHYSICS            3                                                  EVAPORAT
PHYSICS            1                                                  COALESCE
LOW-PWXS                          $NTEMP                              JEFF-3.3
* 1 keV photons by default; 100 keV electron kinetic cutoff.
EMFCUT        -$ECUT     $GCUT              VACREG       TGT
EMFCUT        -$ECUT     $GCUT         1  HYDROGEN     RACL2          PROD-CUT
#if PHNUC
PHOTONUC           1                      HYDROGEN     RACL2
#endif
RADDECAY           1         1         3
* Durations in seconds; singly charged proton beam intensity in p/s.
IRRPROFI       $IRRT     $RATE
DCYTIMES           0      3600      7200     10800     14400     18000
DCYTIMES       21600     25200     28800     32400     36000     39600
DCYTIMES       43200     46800     50400     54000     57600     61200
DCYTIMES       64800     68400     72000     75600     79200     82800
DCYTIMES       86400    172800    259200    345600    432000    518400
DCYTIMES      604800    691200    777600    864000
RANDOMIZ           1     $SEED
* Six material-region inventories; Al front/side/back combined as ALCASE.
RESNUCLE           3       -21                        ALCASE         1Y0
RESNUCLE           3       -21                           WAT         1Y2
RESNUCLE           3       -21                         TAWIN         1Y3
RESNUCLE           3       -21                        CUBACK         1Y5
RESNUCLE           3       -21                          COOL         1Y6
RESNUCLE           3       -21                           TGT         1Y4
