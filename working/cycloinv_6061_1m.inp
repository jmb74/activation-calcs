USRBDX         $EMAX     $GCUT    $NBINS  6.283185         0         1 &
USRBDX            -1    PHOTON       -24      HAV1    VACREG    $SAREAPRPHJ
USRBDX         $EMAX     $GCUT    $NBINS  6.283185         0         1 &
USRBIN            12   NEUTRON       -26       TGT                    PRN
USRBIN        ALCASE                             1                     &
USRBIN            12    PHOTON       -26       TGT                    PRP
USRBIN        ALCASE                             1                     &
USRBIN            12    ENERGY       -28       TGT                    EDEP
USRBIN        ALCASE                             1                     &
