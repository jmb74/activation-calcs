USRBIN       -$XYMAX   -$XYMAX     $ZMIN      $NXY      $NXY       $NZ &
#endif
* Diagnostic copy: prompt proton crossing-energy spectra, unit 31.
* Area normalization 1: integrate energy and solid angle for crossings/primary.
* PIN: HAV2 -> salt entry; POUT: salt -> case, including side/back exits.
* 0..40 MeV in 200 linear bins. No DCYSCORE (prompt only).
USRBDX             1    PROTON       -31      HAV2       TGT         1PIN
USRBDX          0.04         0       200  6.283185         0         1 &
USRBDX             1    PROTON       -31       TGT    ALCASE         1POUT
